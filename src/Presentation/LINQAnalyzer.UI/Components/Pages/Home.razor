@page "/"
@using LINQAnalyzer.Domain.Models
@using LINQAnalyzer.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Web
@using Markdig
@inject ScanOrchestratorService Orchestrator
@inject IJSRuntime JS
@inject LINQAnalyzer.Application.Interfaces.IDocumentationAgent DocumentationAgent
@inject LINQAnalyzer.Application.Interfaces.ICodeDiscoveryAgent DiscoveryAgent
@inject LINQAnalyzer.Application.Interfaces.IPdfExportAgent PdfExportAgent
@inject LINQAnalyzer.Application.Interfaces.IBenchmarkAgent BenchmarkAgent
@rendermode InteractiveServer

<PageTitle>LINQ Performance Analyzer</PageTitle>

<div class="container my-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">🚀 LINQ Performance Analyzer</h2>
            <p class="text-muted mb-0">Automated AST code analysis and AI-powered Entity Framework & LINQ optimization engine.</p>
        </div>
    </div>

    <!-- Scan Configuration Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Scan Configuration</h5>
        </div>
        <div class="card-body">
            <!-- Target Repository Inputs -->
            <div class="row g-3 mb-3">
                <div class="col-md-12">
                    <label class="form-label fw-bold">Git Repository URL <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input @bind="request.GitUrl" @bind:event="oninput" class="form-control" placeholder="https://github.com/owner/repo.git" disabled="@isScanning" />
                        <button class="btn btn-outline-primary" type="button" @onclick="FetchBranchesAsync" disabled="@(isFetchingBranches || isScanning)">
                            @if (isFetchingBranches)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <span>Fetching...</span>
                            }
                            else
                            {
                                <span>🔄 Fetch Branches</span>
                            }
                        </button>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Branch</label>
                    @if (availableBranches.Any())
                    {
                        <select @bind="request.Branch" class="form-select" disabled="@isScanning">
                            @foreach (var branch in availableBranches)
                            {
                                <option value="@branch">@branch</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input @bind="request.Branch" class="form-control" placeholder="main" disabled="@isScanning" />
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Personal Access Token (Optional)</label>
                    <input @bind="request.PersonalAccessToken" type="password" class="form-control" placeholder="ghp_..." disabled="@isScanning" />
                </div>
            </div>

            <hr />

            <!-- Rule Selection Panel -->
            <div class="mb-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <label class="form-label fw-bold mb-0">Active AST Analysis Rules (@RuleRegistry.AvailableRules.Count Total)</label>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="SelectAllRules" disabled="@isScanning">Select All</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="DeselectAllRules" disabled="@isScanning">Clear All</button>
                    </div>
                </div>

                <div class="row g-2">
                    @foreach (var rule in RuleRegistry.AvailableRules)
                    {
                        var isChecked = selectedRuleMap.TryGetValue(rule.Id, out var val) && val;
                        <div class="col-md-6">
                            <div class="card h-100 p-2 border @(isChecked ? "border-primary bg-light" : "")">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@rule.Id" 
                                           checked="@isChecked" 
                                           disabled="@isScanning"
                                           @onchange="e => ToggleRule(rule.Id, e.Value)" />
                                    <label class="form-check-label fw-bold" for="@rule.Id">
                                        <span class="badge @GetSeverityBadgeClass(rule.Severity) me-1">@rule.Severity</span>
                                        [@rule.Id] @rule.Name
                                    </label>
                                </div>
                                <small class="text-muted ms-4 mt-1">@rule.Description</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <hr />

            <!-- AI Settings & Launch Button -->
            <div class="row align-items-center g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold mb-1">
                        Max AI Reviews per Scan: 
                        <span class="text-primary fw-bold">
                            @(request.MaxAiEvaluations <= 0 ? "All Discovered Issues (Dynamic)" : request.MaxAiEvaluations.ToString())
                        </span>
                    </label>
                    <input type="range" class="form-range" min="0" max="50" step="5" @bind="request.MaxAiEvaluations" disabled="@isScanning" />
                    <small class="text-muted d-block">Set to 0 to dynamically analyze every single issue found.</small>
                </div>
                <div class="col-md-6 text-end">
                    <button class="btn btn-success btn-lg px-4" @onclick="StartScanAsync" disabled="@isScanning">
                        @if (isScanning)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Analysis & AI Review Active...</span>
                        }
                        else
                        {
                            <span>🔍 Launch Analysis</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Real-Time Progress Tracker -->
    @if (latestProgress != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Stage: <span class="text-primary">@latestProgress.Stage</span></h5>
                    <span class="fw-bold">@(latestProgress.PercentComplete)%</span>
                </div>
                <p class="text-muted mb-2">@latestProgress.Message</p>
                <div class="progress" style="height: 20px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated @(latestProgress.Stage == ScanStage.Failed ? "bg-danger" : "bg-primary")" 
                         role="progressbar" 
                         style="width: @(latestProgress.PercentComplete)%">
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Live Discovered Anti-Patterns & Export Suite -->
    @if (discoveredIssues.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <h4 class="mb-0">Discovered Anti-Patterns (@FilteredIssues.Count() / @discoveredIssues.Count)</h4>
                    
                    <div class="btn-group" role="group">
                        <button class="btn btn-outline-danger btn-sm" @onclick="DownloadPdfReport" disabled="@isScanning">
                            📄 Download PDF
                        </button>
                        <button class="btn btn-outline-primary btn-sm" @onclick="DownloadHtmlReport" disabled="@(isScanning || string.IsNullOrEmpty(generatedHtmlReport))">
                            📥 Download HTML
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CopyMarkdownReport" disabled="@(isScanning || string.IsNullOrEmpty(generatedMarkdownReport))">
                            📋 Copy Markdown
                        </button>
                    </div>
                </div>

                <!-- Severity & Search Filter Controls -->
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light fw-bold">🔎 Search</span>
                            <input type="text" class="form-control" placeholder="Filter by rule, path, or code snippet..." @bind="searchTerm" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn @(selectedSeverityFilter == null ? "btn-dark" : "btn-outline-dark")" @onclick="() => SetSeverityFilter(null)">
                                All (@discoveredIssues.Count)
                            </button>
                            <button type="button" class="btn @(selectedSeverityFilter == RuleSeverity.Critical ? "btn-danger" : "btn-outline-danger")" @onclick="() => SetSeverityFilter(RuleSeverity.Critical)">
                                Critical (@discoveredIssues.Count(i => GetSeverityForRule(i.RuleId) == RuleSeverity.Critical))
                            </button>
                            <button type="button" class="btn @(selectedSeverityFilter == RuleSeverity.Warning ? "btn-warning" : "btn-outline-warning")" @onclick="() => SetSeverityFilter(RuleSeverity.Warning)">
                                Warning (@discoveredIssues.Count(i => GetSeverityForRule(i.RuleId) == RuleSeverity.Warning))
                            </button>
                            <button type="button" class="btn @(selectedSeverityFilter == RuleSeverity.Info ? "btn-info" : "btn-outline-info")" @onclick="() => SetSeverityFilter(RuleSeverity.Info)">
                                Info (@discoveredIssues.Count(i => GetSeverityForRule(i.RuleId) == RuleSeverity.Info))
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            @foreach (var issue in FilteredIssues)
            {
                var severity = GetSeverityForRule(issue.RuleId);
                <div class="col-12">
                    <div class="card shadow-sm border-start border-4 @(severity == RuleSeverity.Critical ? "border-danger" : severity == RuleSeverity.Warning ? "border-warning" : "border-info")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0 text-dark fw-bold">
                                    <span class="badge @GetSeverityBadgeClass(severity) me-2">@issue.RuleId</span>
                                    @issue.RuleName
                                </h5>
                                <div>
                                    <button class="btn btn-sm btn-outline-dark me-2" @onclick="() => DownloadBenchmarkFile(issue)">
                                        ⚡ Download Benchmark (.cs)
                                    </button>
                                    <span class="text-muted small">Line @issue.LineNumber</span>
                                </div>
                            </div>

                            <p class="mb-2 text-muted">📁 <code>@issue.FilePath</code></p>

                            <!-- Code Snippet with Copy Button -->
                            <div class="bg-dark text-light p-3 rounded mb-3 position-relative">
                                <button class="btn btn-sm btn-secondary position-absolute top-0 end-0 m-2 opacity-75" 
                                        @onclick="() => CopyToClipboard(issue.Snippet)" title="Copy Code Snippet">
                                    📋 Copy
                                </button>
                                <pre class="m-0" style="white-space: pre-wrap;"><code>@issue.Snippet</code></pre>
                            </div>

                            <!-- Performance Impact Cards -->
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="p-2 border rounded bg-light text-center">
                                        <small class="text-muted d-block">Estimated Memory Impact</small>
                                        <strong class="text-danger">@((issue.EstimatedAllocatedBytes / 1024.0).ToString("N1")) KB</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-2 border rounded bg-light text-center">
                                        <small class="text-muted d-block">Est. Execution Time</small>
                                        <strong class="text-warning">@issue.ExecutionTimeMs.ToString("F2") ms</strong>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(issue.SimulatedSql))
                            {
                                <div class="border rounded p-3 mb-3 bg-light">
                                    <h6 class="fw-bold text-primary mb-2">⚡ Simulated SQL Translation</h6>
                                    <pre class="m-0 text-dark small"><code>@issue.SimulatedSql</code></pre>
                                </div>
                            }

                            <!-- AI Guidance Section with Live Loader -->
                            <div class="bg-light border rounded p-3 mt-2">
                                <h6 class="fw-bold text-success mb-2">🤖 AI Optimization Guidance</h6>
                                
                                @if (!string.IsNullOrWhiteSpace(issue.AiAnalysis))
                                {
                                    <div class="text-dark small ai-markdown-container">
                                        @((MarkupString)Markdown.ToHtml(issue.AiAnalysis, markdownPipeline))
                                    </div>
                                }
                                else if (isScanning)
                                {
                                    <!-- AI Processing Loader -->
                                    <div class="d-flex align-items-center p-3 text-muted bg-white border rounded">
                                        <div class="spinner-border spinner-border-sm text-success me-3" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <div>
                                            <strong class="text-dark d-block">Generating AI optimization & refactored code...</strong>
                                            <small class="text-muted">Evaluating query pattern via LLM engine...</small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">No AI analysis available for this item.</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private ScanRequest request = new ScanRequest();
    private bool isScanning = false;
    private ScanProgress? latestProgress;
    private List<DiscoveredIssue> discoveredIssues = new();
    private Dictionary<string, bool> selectedRuleMap = new();

    private string generatedHtmlReport = string.Empty;
    private string generatedMarkdownReport = string.Empty;

    // Filter and search state
    private string searchTerm = string.Empty;
    private RuleSeverity? selectedSeverityFilter = null;

    // Branch fetching state
    private List<string> availableBranches = new();
    private bool isFetchingBranches = false;
    private string? branchFetchError = null;

    // Markdig Pipeline configuration
    private readonly MarkdownPipeline markdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private IEnumerable<DiscoveredIssue> FilteredIssues => discoveredIssues
        .Where(issue => selectedSeverityFilter == null || GetSeverityForRule(issue.RuleId) == selectedSeverityFilter)
        .Where(issue => string.IsNullOrWhiteSpace(searchTerm) ||
                        issue.RuleName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                        issue.FilePath.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                        issue.Snippet.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        request.MaxAiEvaluations = 0;

        foreach (var rule in RuleRegistry.AvailableRules)
        {
            selectedRuleMap[rule.Id] = rule.IsEnabledByDefault;
        }
    }

    private void SetSeverityFilter(RuleSeverity? severity)
    {
        selectedSeverityFilter = severity;
    }

    private void ToggleRule(string ruleId, object? value)
    {
        if (value is bool isChecked)
        {
            selectedRuleMap[ruleId] = isChecked;
        }
    }

    private void SelectAllRules()
    {
        foreach (var rule in RuleRegistry.AvailableRules)
        {
            selectedRuleMap[rule.Id] = true;
        }
    }

    private void DeselectAllRules()
    {
        foreach (var rule in RuleRegistry.AvailableRules)
        {
            selectedRuleMap[rule.Id] = false;
        }
    }

    private async Task FetchBranchesAsync()
    {
        if (string.IsNullOrWhiteSpace(request.GitUrl))
            return;

        isFetchingBranches = true;
        branchFetchError = null;
        availableBranches.Clear();

        try
        {
            availableBranches = await DiscoveryAgent.GetRemoteBranchesAsync(request.GitUrl, request.PersonalAccessToken);

            if (availableBranches.Contains("main"))
                request.Branch = "main";
            else if (availableBranches.Contains("master"))
                request.Branch = "master";
            else if (availableBranches.Any())
                request.Branch = availableBranches.First();
        }
        catch (Exception ex)
        {
            branchFetchError = $"Failed to fetch branches: {ex.Message}";
        }
        finally
        {
            isFetchingBranches = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartScanAsync()
    {
        if (string.IsNullOrWhiteSpace(request.GitUrl))
            return;

        request.SelectedRuleIds = selectedRuleMap
            .Where(kvp => kvp.Value)
            .Select(kvp => kvp.Key)
            .ToList();

        isScanning = true;
        discoveredIssues.Clear();
        generatedHtmlReport = string.Empty;
        generatedMarkdownReport = string.Empty;

        try
        {
            var result = await Orchestrator.ExecuteScanAsync(request, async progress =>
            {
                latestProgress = progress;
                if (progress.LatestIssue != null)
                {
                    var existing = discoveredIssues.FirstOrDefault(i => 
                        i.RuleId == progress.LatestIssue.RuleId && 
                        i.FilePath == progress.LatestIssue.FilePath && 
                        i.LineNumber == progress.LatestIssue.LineNumber);

                    if (existing == null)
                    {
                        discoveredIssues.Add(progress.LatestIssue);
                    }
                    else
                    {
                        if (!string.IsNullOrEmpty(progress.LatestIssue.AiAnalysis))
                        {
                            existing.AiAnalysis = progress.LatestIssue.AiAnalysis;
                        }
                    }
                }
                await InvokeAsync(StateHasChanged);
            });

            generatedHtmlReport = result.HtmlReport;
            generatedMarkdownReport = await DocumentationAgent.GenerateMarkdownReportAsync(request, discoveredIssues);
        }
        catch (Exception ex)
        {
            latestProgress = new ScanProgress(request.Id, ScanStage.Failed, 0, $"Error: {ex.Message}");
        }
        finally
        {
            isScanning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CopyToClipboard(string text)
    {
        if (!string.IsNullOrEmpty(text))
        {
            await JS.InvokeVoidAsync("copyToClipboard", text);
        }
    }

    private async Task DownloadBenchmarkFile(DiscoveredIssue issue)
    {
        string benchmarkCode = BenchmarkAgent.GenerateBenchmarkHarness(issue, issue.AiAnalysis ?? issue.Snippet);
        string fileName = $"{issue.RuleId.Replace("-", "_")}_Benchmark.cs";
        await JS.InvokeVoidAsync("downloadFileFromText", fileName, benchmarkCode, "text/plain");
    }

    private async Task DownloadHtmlReport()
    {
        if (!string.IsNullOrEmpty(generatedHtmlReport))
        {
            await JS.InvokeVoidAsync("downloadFileFromText", "LINQ_Performance_Report.html", generatedHtmlReport, "text/html");
        }
    }

    private async Task CopyMarkdownReport()
    {
        if (!string.IsNullOrEmpty(generatedMarkdownReport))
        {
            await JS.InvokeVoidAsync("copyToClipboard", generatedMarkdownReport);
        }
    }

    private async Task DownloadPdfReport()
    {
        if (discoveredIssues.Any())
        {
            try
            {
                byte[] pdfBytes = PdfExportAgent.GeneratePdfReport(request, discoveredIssues);
                string base64 = Convert.ToBase64String(pdfBytes);
                await JS.InvokeVoidAsync("downloadFileFromBase64", "LINQ_Performance_Report.pdf", base64, "application/pdf");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"PDF Export Error: {ex.Message}");
            }
        }
    }

    private RuleSeverity GetSeverityForRule(string ruleId)
    {
        var rule = RuleRegistry.AvailableRules.FirstOrDefault(r => r.Id == ruleId);
        return rule?.Severity ?? RuleSeverity.Warning;
    }

    private string GetSeverityBadgeClass(RuleSeverity severity) => severity switch
    {
        RuleSeverity.Critical => "bg-danger",
        RuleSeverity.Warning => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };
}